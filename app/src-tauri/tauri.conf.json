{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "소셜 엔지니어",
  "version": "0.1.0",
  "identifier": "com.socialengineer.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run fetch-llama && npm run dev",
    "beforeBuildCommand": "npm run fetch-llama && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "소셜 엔지니어",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "llama/": "llama/"
    }
  }
}
